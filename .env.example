DATABASE_URL=
GEMINI_API_KEY=
PORT=3000
SQL_ADMIN_PASSWORD=
SQL_ADMIN_USER=
SQL_DB_NAME=
SQL_HOST=
SQL_PASSWORD=
SQL_USER=

# Firebase Client Configuration (malawi-harvest-hub)
# Retrieve these values from Firebase Console -> Project Settings -> General -> Your apps (Web app)
VITE_FIREBASE_PROJECT_ID=malawi-harvest-hub
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_AUTH_DOMAIN=malawi-harvest-hub.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=malawi-harvest-hub.firebasestorage.app

# Web Push Certificate (VAPID key)
# Retrieve from Firebase Console -> Project Settings -> Cloud Messaging -> Web configuration -> Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# Backend Firebase Admin SDK Credentials for malawi-harvest-hub
# Optional: Path to service-account.json or raw JSON string for server push dispatch
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=